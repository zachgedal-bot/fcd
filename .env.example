# After Hours service configuration. Copy to the host's environment settings; never commit real values.
PORT=8080

# Odds provider (The Odds API v4). Without this the Altitude Book shows "Lines unavailable"; nothing is simulated.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com
ODDS_REGIONS=us,eu
# Leave empty to auto-discover Liga MX, NWSL, Libertadores, Sudamericana, Bolivia, Ecuador, Colombia, Peru, MLS from the provider's sports list
ODDS_SPORT_KEYS=
ODDS_CACHE_SECONDS=300

# Gate. Set codes to require an invite + 18+ attestation server-side. SESSION_SECRET must be a long random string.
AFTER_HOURS_INVITE_CODES=
SESSION_SECRET=
SESSION_HOURS=168

HOME_URL=https://athlemix.com
# Set to 1 behind Render/Fly/Railway/Cloudflare so cookies are marked Secure
TRUST_PROXY=1
