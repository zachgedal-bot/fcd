# After Hours service configuration. Copy to the host's environment settings; never commit real values.
PORT=8080

# Odds provider (The Odds API v4). Without this the Altitude Book shows "Lines unavailable"; nothing is simulated.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com
ODDS_REGIONS=us,eu
# Leave empty to auto-discover from the provider's sports list. The Odds API carries Liga MX, Copa Libertadores, Copa Sudamericana,
# MLS and the CONMEBOL World Cup qualifiers (in season). It does NOT carry NWSL or the Bolivian, Ecuadorian, Colombian or Peruvian
# leagues; those need a different provider (see DEPLOY.md).
ODDS_SPORT_KEYS=
ODDS_CACHE_SECONDS=300
# Metered-call protection. refresh=1 on /api/fixtures is ignored unless this token is set and sent as x-refresh-token,
# and even then only one forced refresh per ODDS_MIN_REFRESH_SECONDS is honoured. API_RATE_LIMIT caps /api/fixtures + /api/props per IP per minute.
ODDS_REFRESH_TOKEN=
ODDS_MIN_REFRESH_SECONDS=60
API_RATE_LIMIT=60

# Gate. Set codes to require an invite + 18+ attestation server-side. SESSION_SECRET must be a long random string.
AFTER_HOURS_INVITE_CODES=
SESSION_SECRET=
SESSION_HOURS=168

HOME_URL=https://athlemix.com
# Number of trusted reverse-proxy hops in front of the service: 1 for Render/Fly/Railway alone, 2 with Cloudflare in front.
# The client IP (for rate limits) is read from X-Forwarded-For that many entries from the RIGHT. Also enables Secure cookies.
TRUST_PROXY=1
# Optional authenticated client-IP header from the platform, preferred over X-Forwarded-For when set:
# fly-client-ip (Fly), true-client-ip (Render), cf-connecting-ip (Cloudflare), x-real-ip (nginx/Caddy)
CLIENT_IP_HEADER=
